{{define "module" -}}
// Code generated by inject; DO NOT EDIT.

package {{.Package}}

import (
	"sync"

	"go.uber.org/fx"
{{range .Imports}}
	{{.Alias}} "{{.Path}}"
{{- end}}
)

var {{.Func}}Once sync.Once

// {{.Func}}Module registers {{.Source}}.{{.Func}} and the modules it depends on.
// It returns an empty option after the first call, so a constructor shared by
// several modules is registered only once.
func {{.Func}}Module() fx.Option {
	options := fx.Options()

	{{.Func}}Once.Do(func() {
		options = fx.Module("{{.Source}}.{{.Func}}",
{{- range .Deps}}
			{{.}},
{{- end}}
			fx.{{.Kind}}({{.Target}}),
		)
	})

	return options
}
{{end}}

{{define "root" -}}
// Code generated by inject; DO NOT EDIT.

package {{.Package}}

import (
	"go.uber.org/fx"
{{range .Imports}}
	{{.Alias}} "{{.Path}}"
{{- end}}
)

// Module registers every module generated by inject.
func Module() fx.Option {
	return fx.Options(
{{- range .Modules}}
		{{.}},
{{- end}}
	)
}
{{end}}

{{define "implementation" -}}
// Code generated by inject; DO NOT EDIT.

package {{.Package}}

import (
	"sync"

	"github.com/xgodev/boost/model/errors"
	"github.com/xgodev/boost/wrapper/config"
	"go.uber.org/fx"
{{range .Imports}}
	{{.Alias}} "{{.Path}}"
{{- end}}
)

// {{.Var}}ImplementationKey chooses the implementation of {{.Type}}.
const {{.Var}}ImplementationKey = "{{.Key}}"

func init() {
	config.Add({{.Var}}ImplementationKey, "{{.Default}}", "implementation of {{.Type}}: {{.Names}}")
}

// {{.Ident}}Implementation returns the name of the implementation of
// {{.Type}} that {{.Ident}}ImplementationModule wires.
func {{.Ident}}Implementation() string {
	return config.String({{.Var}}ImplementationKey)
}

var {{.Var}}ImplementationOnce sync.Once

// {{.Ident}}ImplementationModule wires the implementation of {{.Type}}
// named by {{.Key}} ({{.Names}}; default {{.Default}}) and only that one.
// An unknown name fails the boot. It returns an empty option after the first
// call, so every consumer can include it.
func {{.Ident}}ImplementationModule() fx.Option {
	options := fx.Options()

	{{.Var}}ImplementationOnce.Do(func() {
		switch name := {{.Ident}}Implementation(); name {
{{- range .Cases}}
		case "{{.Name}}":
			options = {{.Module}}
{{- end}}
		default:
			options = fx.Error(errors.NotValidf("%s: unknown implementation %q; valid: %s", {{.Var}}ImplementationKey, name, "{{.Names}}"))
		}
	})

	return options
}
{{end}}
